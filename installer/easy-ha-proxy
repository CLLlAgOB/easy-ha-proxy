#!/usr/bin/env bash
set -euo pipefail

install_root="${EASY_HA_PROXY_HOME:-/opt/easy-ha-proxy}"
source_dir="${EASY_HA_PROXY_SOURCE_DIR:-${install_root}/source}"
agent_bin="${EASY_HA_PROXY_AGENT_BIN:-/usr/local/sbin/easy-ha-proxy-agent}"
staged_agent="${EASY_HA_PROXY_STAGED_AGENT:-/var/lib/easy-ha-proxy/native-staging/bootstrap/easy-ha-proxy-agent}"

export EASY_HA_PROXY_SOURCE_DIR="${source_dir}"

# The installer is the host agent's "cli".
if [[ -x "${agent_bin}" ]] && "${agent_bin}" cli --probe >/dev/null 2>&1; then
  exec "${agent_bin}" cli "$@"
fi
if [[ -x "${staged_agent}" ]] && "${staged_agent}" cli --probe >/dev/null 2>&1; then
  exec "${staged_agent}" cli "$@"
fi

# No agent that runs the installer yet: a fresh host, or the first update
# from a release whose installer was Python. Fetch the agent built for this
# source; the native stage then installs it for good.
if [[ "${EUID}" -ne 0 ]]; then
  echo "easy-ha-proxy: the host agent is not installed yet; run this as root to fetch it." >&2
  exit 1
fi
# shellcheck source=installer/agent-fetch.sh
source "${source_dir}/installer/agent-fetch.sh"
easy_ha_proxy_fetch_agent "${source_dir}" "${staged_agent}"
if ! easy_ha_proxy_agent_runs_cli "${staged_agent}"; then
  echo "easy-ha-proxy: the fetched host agent cannot run the installer; it is older than this source." >&2
  exit 1
fi
exec "${staged_agent}" cli "$@"
