#!/usr/bin/env bash
set -euo pipefail

install_root="${EASY_HA_PROXY_HOME:-/opt/easy-ha-proxy}"
source_dir="${EASY_HA_PROXY_SOURCE_DIR:-${install_root}/source}"
agent_bin="${EASY_HA_PROXY_AGENT_BIN:-/usr/local/sbin/easy-ha-proxy-agent}"
staged_agent="${EASY_HA_PROXY_STAGED_AGENT:-/var/lib/easy-ha-proxy/native-staging/bootstrap/easy-ha-proxy-agent}"

export EASY_HA_PROXY_SOURCE_DIR="${source_dir}"

if [[ -x "${agent_bin}" ]] && "${agent_bin}" cli --probe >/dev/null 2>&1; then
  exec "${agent_bin}" cli "$@"
fi
if [[ -x "${staged_agent}" ]] && "${staged_agent}" cli --probe >/dev/null 2>&1; then
  exec "${staged_agent}" cli "$@"
fi

# Transitional bootstrap fallback for a fresh host or a one-time upgrade from a
# host agent predating "easy-ha-proxy-agent cli".
python_bin="${install_root}/venv/bin/python"
if [[ ! -x "${python_bin}" ]]; then
  python_bin="$(command -v python3 || true)"
fi
if [[ -z "${python_bin}" || ! -x "${python_bin}" ]]; then
  echo "easy-ha-proxy: host agent not found (${agent_bin}) and python3 is unavailable for bootstrap." >&2
  echo "Run install-local.sh first." >&2
  exit 1
fi

exec "${python_bin}" "${source_dir}/installer/easy_ha_proxy.py" "$@"
