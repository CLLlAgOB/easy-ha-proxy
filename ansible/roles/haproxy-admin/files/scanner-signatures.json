{
  "version": "2026-08-20",
  "source": "curated, plus paths mined from 713945 requests across two live gateways",
  "notes": [
    "A category is decisive when no client has any legitimate reason to ask:",
    "one request is the whole answer rather than a hint. Everything else is",
    "probable and needs a spread across categories to mean anything.",
    "",
    "segments are matched against every path segment, not only the first:",
    "the most common attack in the mined logs -- CVE-2017-9841, the phpunit",
    "eval-stdin.php remote execution -- arrives as /laravel/vendor/phpunit/...",
    "and /lib/phpunit/... far more often than as /vendor/phpunit/...",
    "",
    "traps are paths this installation does not serve and never links to.",
    "Nothing can reach one by accident, so a request for one is decisive by",
    "construction. Add your own; they cost nothing and never false-positive."
  ],

  "decisive": [
    "secrets",
    "vcs",
    "backup",
    "rce-probe",
    "container-api",
    "shell",
    "trap"
  ],

  "segments": {
    ".env": "secrets",
    ".env.local": "secrets",
    ".env.production": "secrets",
    ".git": "vcs",
    ".svn": "vcs",
    ".hg": "vcs",
    ".aws": "secrets",
    ".ssh": "secrets",
    ".DS_Store": "secrets",
    ".vscode": "secrets",
    ".idea": "secrets",
    "id_rsa": "secrets",
    "id_ed25519": "secrets",
    "credentials": "secrets",
    "secrets.yml": "secrets",
    "phpunit": "rce-probe",
    "eval-stdin.php": "rce-probe",
    "phpmyadmin": "database-admin",
    "pma": "database-admin",
    "myadmin": "database-admin",
    "adminer.php": "database-admin",
    "wp-login.php": "wordpress",
    "wp-admin": "wordpress",
    "wp-content": "wordpress",
    "wp-includes": "wordpress",
    "wp-config.php": "secrets",
    "wp-config.php.bak": "secrets",
    "xmlrpc.php": "wordpress",
    "server-status": "server-info",
    "server-info": "server-info",
    "phpinfo.php": "server-info",
    "actuator": "app-framework",
    "solr": "app-framework",
    "jenkins": "app-framework",
    "struts": "app-framework",
    "telescope": "app-framework",
    "cgi-bin": "legacy-cgi",
    "vendor": "dependency",
    "backup.zip": "backup",
    "backup.sql": "backup",
    "backup.tar.gz": "backup",
    "database.sql": "backup",
    "dump.sql": "backup",
    "config.php": "config",
    "configuration.php": "config",
    "web.config": "config",
    "docker-compose.yml": "config"
  },

  "paths": {
    "/.env": "secrets",
    "/.git/config": "vcs",
    "/.git/HEAD": "vcs",
    "/.aws/credentials": "secrets",
    "/.ssh/id_rsa": "secrets",
    "/.vscode/sftp.json": "secrets",
    "/containers/json": "container-api",
    "/v1.24/containers/json": "container-api",
    "/bin/sh": "shell",
    "/bin/bash": "shell",
    "/hello.world": "rce-probe",
    "/test.hello": "rce-probe",
    "/debug/default/view": "app-framework",
    "/telescope/requests": "app-framework"
  },

  "traps": []
}
