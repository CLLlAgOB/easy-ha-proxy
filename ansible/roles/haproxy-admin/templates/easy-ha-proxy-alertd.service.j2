# /etc/systemd/system/easy-ha-proxy-alertd.service
[Unit]
Description=easy-ha-proxy-alertd (root, alert engine and notifications)
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
User=root
Group={{ app_group | default('hadmin') }}

Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-{{ haproxy_admin_env_file }}
Environment="ALERTD_SOCKET_PATH={{ alertd_socket_path | default('/run/easy-ha-proxy/easy-ha-proxy-alertd.sock') }}"
Environment="ALERTD_SOCKET_GROUP={{ alertd_socket_group | default(app_group | default('hadmin')) }}"
Environment="ALERTD_CONFIG={{ alertd_config_path | default((app_dir | default('/opt/haproxy-admin')) ~ '/alertd.json') }}"
Environment="ALERTD_DATABASE={{ alertd_database_path | default('/var/lib/easy-ha-proxy/alerts/alerts.db') }}"
Environment="ALERTD_MAIL_STATE={{ alertd_mail_state | default('/etc/easy-ha-proxy/mail-notify.json') }}"
Environment="ALERTD_MAIL_LOCK={{ alertd_mail_lock | default('/run/easy-ha-proxy/authelia-mail.lock') }}"
# Submitting an observation invents an outage and changing the rules silences
# one, so both are gated by the shared token. Reads stay open to the hadmin
# group like every other helper socket.
Environment="ALERTD_TOKEN={{ haproxy_admin_proxy_secret | default(authelia_session_secret | default('')) }}"
Environment="ALERTD_GATEWAY_NAME={{ alertd_gateway_name | default(haproxy_admin_domain | default('')) }}"
Environment="EASY_HA_PROXY_DAEMON_VERSION={{ lookup('ansible.builtin.file', role_path ~ '/files/easy-ha-proxy-alertd.py', rstrip=false) | hash('sha256') }}"

ExecStart=/usr/bin/python3 /usr/local/sbin/easy-ha-proxy-alertd.py

Restart=always
RestartSec=5

RuntimeDirectory=easy-ha-proxy
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=easy-ha-proxy/alerts
StateDirectoryMode=0750
UMask=0007

# The daemon keeps its own state, reads the shared mail settings, and reaches
# the mail relay through the docker socket. Nothing else needs to be writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The engine itself only speaks over its unix socket; AF_NETLINK and AF_INET
# are what the docker client needs to reach the daemon and the relay.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths={{ alertd_mail_state | default('/etc/easy-ha-proxy/mail-notify.json') }}
ReadWritePaths={{ (alertd_config_path | default((app_dir | default('/opt/haproxy-admin')) ~ '/alertd.json')) | dirname }}

# The state is a small SQLite file and a handful of rows in memory; this is the
# backstop that keeps a mistake there from crowding out HAProxy.
MemoryMax={{ alertd_memory_max | default('128M') }}

[Install]
WantedBy=multi-user.target
