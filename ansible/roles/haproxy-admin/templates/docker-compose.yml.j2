services:
  haproxy-admin:
    image: "{{ haproxy_admin_image }}"
    container_name: "{{ haproxy_admin_container_name }}"
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 256
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=64m

    {% if haproxy_admin_uid is defined and haproxy_admin_gid is defined
          and haproxy_admin_uid|length > 0 and haproxy_admin_gid|length > 0 %}
    # Run the container as the host haproxyadmin UID/GID.
    user: "{{ haproxy_admin_uid }}:{{ haproxy_admin_gid }}"
    {% endif %}

    {% if hadmin_gid is defined and hadmin_gid|length > 0 %}
    # Add the host hadmin GID for access to /run/haproxy/admin.sock.
    group_add:
      - "{{ hadmin_gid }}"
    {% endif %}

    env_file:
      - "{{ haproxy_admin_env_file }}"

    environment:
      TZ: "{{ haproxy_admin_timezone }}"
      HOME: "/tmp"
      HAPROXY_ADMIN_SECRET_FILE: "/var/lib/haproxy-admin/secret_key"
      HAPROXY_ADMIN_GEOIP_DB: "/etc/haproxy/geoip/current/dbip-country-lite.mmdb"
      AUDIT_DATABASE: "{{ audit_database_path | default('/var/lib/easy-ha-proxy/audit/audit.db') }}"

    volumes:
      - "{{ haproxy_admin_data_dir }}:/var/lib/haproxy-admin"
      - "/opt/authelia/logs:/opt/authelia/logs:ro"
      - "/etc/haproxy:/etc/haproxy:ro"
      - "{{ whitelist_global_file }}:{{ whitelist_global_file }}:rw"
      - "{{ whitelist_geo_file }}:{{ whitelist_geo_file }}:rw"
      - "/var/log/haproxy.log:/var/log/haproxy.log:ro"
      - "/run/haproxy:/run/haproxy:ro"
      - "/run/easy-ha-proxy:/run/easy-ha-proxy:ro"
      # The only writable state outside the app's own data directory: the
      # change log. Scoped to that one directory rather than /var/lib.
      - "{{ (audit_database_path | default('/var/lib/easy-ha-proxy/audit/audit.db')) | dirname }}:{{ (audit_database_path | default('/var/lib/easy-ha-proxy/audit/audit.db')) | dirname }}:rw"
      - "/opt/haproxy-admin/config:/opt/haproxy-admin/config"
      - "/opt/haproxy-admin/backups:/opt/haproxy-admin/backups"
      - "{{ backupd_uploads_dir }}:{{ backupd_uploads_dir }}:rw"
      - "{{ backupd_backups_dir }}:{{ backupd_backups_dir }}:ro"
    ports:
      - "127.0.0.1:{{ haproxy_admin_listen_port }}:5000"

    # Exercise the same authenticated request boundary as HAProxy without
    # exposing a separate unauthenticated readiness endpoint. Python is
    # already part of the application image, so no extra utility is needed.
    #
    # The request is written onto a socket by hand rather than handed to
    # urllib, which sounds like showing off and is not. Measured on a live
    # gateway as container CPU per run: urllib 329 ms, this 111 ms. Nearly
    # all of the difference is importing urllib.request, which drags in
    # http.client, email and ssl in order to send eleven lines of plain
    # HTTP. A bare interpreter start is 17 ms, so what is left here is
    # mostly gunicorn answering, and no client can make that part cheaper.
    #
    # At ten second intervals the old form cost about 2800 core-seconds a
    # day, which was very nearly the entire CPU consumption of this
    # container: 4154 core-seconds over the 36 hours that were measured.
    #
    # What is checked has not changed: same endpoint, same three headers,
    # same 200, same {"ok": true}. A wrong secret, a wrong identity and a
    # dead port were each confirmed to still fail it.
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - |-
          import os, socket
          request = (
              "GET /api/control-plane-health HTTP/1.0\r\n"
              "Host: 127.0.0.1\r\n"
              "X-Easy-HA-Proxy-Secret: "
              + os.environ["HAPROXY_ADMIN_PROXY_SECRET"] + "\r\n"
              "Remote-User: easy-ha-proxy-healthcheck\r\n"
              "Remote-Groups: healthcheck\r\n"
              "Connection: close\r\n"
              "\r\n"
          )
          connection = socket.create_connection(("127.0.0.1", 5000), timeout=3)
          connection.sendall(request.encode())
          answer = b"".join(iter(lambda: connection.recv(4096), b""))
          assert answer.split(b"\r\n", 1)[0].split()[1] == b"200"
          assert b'"ok": true' in answer
      # Thirty seconds rather than ten. What remains per run is gunicorn
      # serving the request, and only asking less often reduces that. The
      # window before a wedged container is called unhealthy is unchanged:
      # it was 12 x 10s, it is 4 x 30s, two minutes either way.
      interval: 30s
      timeout: 5s
      retries: 4
      start_period: 10s

    networks:
      - hadmin_net

networks:
  hadmin_net:
    external: true
    name: hadmin_net
