# /etc/systemd/system/haproxy-healthd.service
[Unit]
Description=haproxy-healthd (root, Unix socket health monitor)
After=network.target
Wants=network.target

After=docker.service
Wants=docker.service

[Service]
Environment="EASY_HA_PROXY_PANEL_SOCKET_USER={{ app_user | default('haproxyadmin') }}"
Type=simple
User=root
Group={{ app_group | default('hadmin') }}

EnvironmentFile=-{{ daemons_env_file | default('/etc/easy-ha-proxy/daemons.env') }}
Environment="HEALTHD_SOCKET_PATH={{ healthd_socket_path | default('/run/easy-ha-proxy/haproxy-healthd.sock') }}"
Environment="HEALTHD_CONFIG={{ healthd_config_path | default('/opt/haproxy-admin/healthd.json') }}"
Environment="HEALTHD_SOCKET_GROUP={{ healthd_socket_group | default('hadmin') }}"
# Reporting to the alert engine is optional and best effort; without
# the token this daemon simply keeps its observations to itself.
Environment="ALERTD_SOCKET_PATH={{ alertd_socket_path | default('/run/easy-ha-proxy/easy-ha-proxy-alertd.sock') }}"

ExecStart={{ native_agent_bin | default('/usr/local/sbin/easy-ha-proxy-agent') }} healthd

Restart=always
RestartSec=3
# ProtectSystem=strict leaves /run read-only except these: the socket
# directory and the journalctl --cursor-file directory of the "follow"
# log mode (HEALTHD_CURSOR_DIR in both daemons).
RuntimeDirectory=easy-ha-proxy haproxy-healthd-cursors
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=easy-ha-proxy
StateDirectoryMode=0750
UMask=0007
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax={{ healthd_memory_max | default('128M') }}

[Install]
WantedBy=multi-user.target
