# /etc/systemd/system/easy-ha-proxy-backup.service
[Unit]
Description=Scheduled easy-ha-proxy backup and off-host copy
After=network-online.target easy-ha-proxy-backupd.service
Wants=network-online.target
# The daemon reports its own failures; this covers the ones that happen before
# it is ever reached, which is how a broken runner stayed invisible.
OnFailure=easy-ha-proxy-unit-failed@%n.service

[Service]
Type=oneshot
User=root
# The daemon owns the maintenance lock, so the timer only asks it to run and
# polls for the job result. Doing the work here would race a restore or an update.
ExecStart={{ native_agent_bin | default('/usr/local/sbin/easy-ha-proxy-agent') }} backup-run
TimeoutStartSec={{ backup_schedule_timeout | default('8h') }}
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
MemoryMax=128M
