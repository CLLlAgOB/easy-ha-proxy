[Unit]
Description=HAProxy control daemon (bansync + reload) — haproxy-controld
After=network-online.target haproxy.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ haproxy_admin_env_file }}
Environment="EASY_HA_PROXY_REBOOT_MARKER={{ maintenance_reboot_marker_path | default('/run/easy-ha-proxy/easy-ha-proxy-web-reboot.json') }}"
Environment="HAPROXY_ADMIN_ALLOWLIST_PATH={{ admin_ips_file | default('/etc/haproxy/admin.allow') }}"
# Can be overridden through .env:
# SOCKET_PATH=/run/haproxy/admin.sock
# HAPADM_BAN_TABLE=tbl_ban
# HAPADM_IPSET_NAME=haproxy_ban
# HAPADM_BAN_SYNC_INTERVAL=10
# HAPROXY_CONTROL_SOCKET=/run/easy-ha-proxy/haproxy-controld.sock
# HAPROXY_SYSTEMCTL_CMD=systemctl reload haproxy
# Reporting to the alert engine is optional and best effort; without
# the token this daemon simply keeps its observations to itself.
Environment="ALERTD_SOCKET_PATH={{ alertd_socket_path | default('/run/easy-ha-proxy/easy-ha-proxy-alertd.sock') }}"
EnvironmentFile=-{{ daemons_env_file | default('/etc/easy-ha-proxy/daemons.env') }}
Environment="PYTHONDONTWRITEBYTECODE=1"
{% set _controld_hashes = [lookup('ansible.builtin.file', role_path ~ '/files/haproxy-controld.py', rstrip=false) | hash('sha256')] -%}
{% for _controld_mod in (query('ansible.builtin.fileglob', role_path ~ '/files/controld/*.py') | sort) -%}
{%   set _ = _controld_hashes.append(lookup('ansible.builtin.file', _controld_mod, rstrip=false) | hash('sha256')) -%}
{% endfor -%}
Environment="EASY_HA_PROXY_DAEMON_VERSION={{ (_controld_hashes | join(':')) | hash('sha256') }}"
{% if native_controld_enabled | default(false) | bool %}
ExecStart={{ native_agent_bin | default('/usr/local/sbin/easy-ha-proxy-agent') }} controld
{% else %}
ExecStart=/usr/bin/python3 /usr/local/sbin/haproxy-controld.py
{% endif %}
Restart=always
RestartSec=3
User=root
Group={{ app_group }}
RuntimeDirectory=easy-ha-proxy
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0007
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
