# Internal daemon IPC tokens (root-only EnvironmentFile, never in world-readable unit files).
# Derived with explicit domain separation so leaking an internal daemon token cannot
# forge HAPROXY_ADMIN_PROXY_SECRET or authelia_session_secret.
{% set _base_secret = haproxy_admin_proxy_secret | default(authelia_session_secret | default('')) %}
ALERTD_TOKEN={{ alertd_token | default(('alertd:' ~ _base_secret) | hash('sha256') if _base_secret else '') }}
GUARDD_TOKEN={{ guardd_token | default(('guardd:' ~ _base_secret) | hash('sha256') if _base_secret else '') }}
HEALTHD_TOKEN={{ healthd_token | default(('healthd:' ~ _base_secret) | hash('sha256') if _base_secret else '') }}
