# Core socket paths.
SOCKET_PATH={{ socket_path }}
CERTD_SOCKET_PATH={{ certd_socket_path | default('/run/easy-ha-proxy/haproxy-certd.sock') }}
HAPROXY_CONTROL_SOCKET={{ haproxy_control_socket_path | default('/run/easy-ha-proxy/haproxy-controld.sock') }}
BACKUPD_SOCKET_PATH={{ backupd_socket_path | default('/run/easy-ha-proxy/easy-ha-proxy-backupd.sock') }}
BACKUPD_UPLOADS_DIR={{ backupd_uploads_dir | default('/var/lib/easy-ha-proxy/backup-web/uploads') }}
BACKUPD_BACKUPS_DIR={{ backupd_backups_dir | default('/var/lib/easy-ha-proxy/backup-web/backups') }}
BACKUPD_MAX_ARCHIVE_BYTES={{ backupd_max_archive_bytes | default(8589934592) }}
BACKUPD_UPLOAD_TTL_SECONDS={{ backupd_upload_ttl_seconds | default(86400) }}
EASY_HA_PROXY_BACKUPD_SOCKET={{ backupd_socket_path | default('/run/easy-ha-proxy/easy-ha-proxy-backupd.sock') }}
EASY_HA_PROXY_BACKUP_EXCHANGE_ROOT={{ backupd_root_dir | default('/var/lib/easy-ha-proxy/backup-web') }}
EASY_HA_PROXY_BACKUP_MAX_UPLOAD_BYTES={{ backupd_max_archive_bytes | default(8589934592) }}
UPDATED_SOCKET_PATH={{ updated_socket_path | default('/run/easy-ha-proxy/easy-ha-proxy-updated.sock') }}
EASY_HA_PROXY_UPDATED_SOCKET={{ updated_socket_path | default('/run/easy-ha-proxy/easy-ha-proxy-updated.sock') }}
HAPROXY_CERTD_SOCKET_GROUP=hadmin
HAPROXY_ADMIN_PROXY_SECRET={{ haproxy_admin_proxy_secret | default(authelia_session_secret) }}
HAPROXY_ADMIN_DEBUG_ROUTES={{ '1' if haproxy_admin_debug_routes | default(false) | bool else '0' }}
HAPROXY_ADMIN_DEFAULT_LANGUAGE={{ haproxy_admin_default_language | default('en') }}
HEALTHD_SOCKET_PATH={{ healthd_socket_path | default('/run/easy-ha-proxy/haproxy-healthd.sock') }}
HEALTHD_TOKEN={{ haproxy_admin_proxy_secret | default(authelia_session_secret) }}
# HAProxy log and configuration.
LOG_FILE={{ haproxy_log }}
HAPROXY_CFG={{ haproxy_conf }}

# Allow-list files.
WHITELIST_GEO_FILE={{ whitelist_geo_file }}
WHITELIST_GLOBAL_FILE={{ whitelist_global_file }}

# Backend filtering in the UI.
UI_EXCLUDE_EXACT={{ ui_exclude_backends_exact | join(',') }}
UI_EXCLUDE_PREFIX={{ ui_exclude_backends_prefix | join(',') }}

# Journals and ban tables.
HAPADM_JOURNAL_UNIT={{ hapadm_journal_unit }}
HAPADM_JOURNAL_SOURCES={{ hapadm_journal_sources }}
HAPADM_BAN_TABLE={{ hapadm_ban_table }}
HAPADM_BAN_DELTA_SECONDS={{ hapadm_ban_delta_seconds }}
HAPADM_LOG_LIMIT={{ hapadm_log_limit }}
HAPADM_DEBUG_ON_EMPTY={{ hapadm_debug_on_empty }}
HAPADM_IPSET_NAME={{ hapadm_ipset_name }}
HAPADM_BAN_SYNC_INTERVAL={{ hapadm_ban_sync_interval }}

# Flask secret key path mounted inside the container.
HAPROXY_ADMIN_SECRET_FILE=/var/lib/haproxy-admin/secret_key

# Authelia usersd
AUTHELIA_USERS_FILE={{ authelia_users_file | default('/opt/authelia/users_database.yml') }}
AUTHELIA_USERS_SOCKET={{ authelia_users_socket | default('/run/easy-ha-proxy/authelia-usersd.sock') }}
AUTHELIA_USERS_SOCKET_TIMEOUT={{ authelia_users_socket_timeout | default(10) }}
AUTHELIA_USERS_MAX_RESPONSE_BYTES={{ authelia_users_max_response_bytes | default(2097152) }}

# haproxy-certd
HAPROXY_CERTD_DRY_RUN={{ haproxy_certd_dry_run | default('0') }}

# Authelia bans daemon, when enabled.
{% if authelia_bans_enabled | default(true) | bool and authelia_bans_daemon_enabled | default(true) | bool %}
AUTHELIA_BANS_SOCKET={{ authelia_bans_socket_path | default('/run/easy-ha-proxy/authelia-bansd.sock') }}
{% else %}
AUTHELIA_BANS_SOCKET=
AUTHELIA_BANS_CMD=
{% endif %}
AUTHELIA_BANS_SOCKET_TIMEOUT={{ authelia_bans_socket_timeout | default(10) }}
AUTHELIA_BANS_MAX_RESPONSE_BYTES={{ authelia_bans_max_response_bytes | default(2097152) }}

# Authelia log exposed to the UI.
{% if authelia_log_file is defined %}
AUTHELIA_LOG_FILE={{ authelia_log_file }}
{% else %}
AUTHELIA_LOG_FILE=/opt/authelia/logs/authelia.log
{% endif %}

{% if authelia_log_limit is defined %}
AUTHELIA_LOG_LIMIT={{ authelia_log_limit }}
{% endif %}
AUTHELIA_LOG_MAX_SCAN_BYTES={{ authelia_log_max_scan_bytes | default(16777216) }}

# Authelia health check over the container network.
AUTHELIA_HEALTHCHECK_URL={{ authelia_healthcheck_url }}
