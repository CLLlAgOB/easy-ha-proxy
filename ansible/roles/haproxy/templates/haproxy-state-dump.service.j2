# /etc/systemd/system/haproxy-state-dump.service
[Unit]
Description=Dump HAProxy administrative server state
After=haproxy.service
# Losing the dump must never keep HAProxy from starting or stopping.
PartOf=haproxy.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/haproxy-state-dump
# The timer keeps the file fresh for an unexpected restart; the control daemon
# dumps again immediately before every reload it performs, so a planned change
# never restores stale state.
TimeoutStartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
