#!/bin/sh
# Dump HAProxy's administrative server state so a reload can restore it.
#
# Ready/Drain/Maintenance and runtime weights live only in the running process.
# Without this dump, saving any site — which reloads HAProxy — would silently
# return a server under maintenance to service.
#
# Written atomically: HAProxy reads this file at startup, and a half-written
# one would be worse than a stale one.
set -eu

SOCKET="{{ haproxy_socket | default('/run/haproxy/admin.sock') }}"
STATE_FILE="{{ haproxy_server_state_file | default('/var/lib/haproxy/server-state') }}"
CONFIG_FILE="${1:-/etc/haproxy/haproxy.cfg}"
NORMALIZER="${2:-/usr/local/libexec/easy-ha-proxy/haproxy-server-state.py}"
TMP_FILE="${STATE_FILE}.tmp.$$"
FILTERED_FILE="${TMP_FILE}.config-transport"

trap 'rm -f "$TMP_FILE" "$FILTERED_FILE"' EXIT INT TERM

if [ ! -S "$SOCKET" ]; then
    # Also clean a pre-upgrade file before starting a stopped HAProxy.
    if [ ! -s "$STATE_FILE" ]; then exit 0; fi
    cp "$STATE_FILE" "$TMP_FILE"
elif ! echo "show servers state" | socat stdio "$SOCKET" > "$TMP_FILE" 2>/dev/null; then
    # Preserve the last administrative state, but never its TLS override.
    if [ ! -s "$STATE_FILE" ]; then exit 0; fi
    cp "$STATE_FILE" "$TMP_FILE"
fi

# The reply always starts with a version line. Anything shorter means the
# runtime API answered with an error or nothing at all, and overwriting a good
# state file with that would lose every server's state on the next reload.
if [ "$(wc -l < "$TMP_FILE")" -lt 2 ]; then
    if [ ! -s "$STATE_FILE" ]; then exit 0; fi
    cp "$STATE_FILE" "$TMP_FILE"
fi

# Reuse the same rules as package migration and rollback. Only administrative
# controls and applicable health/DNS cache survive; configuration wins for
# addressing, TLS and check transport. Never replace a valid dump on failure.
if ! python3 "$NORMALIZER" --config "$CONFIG_FILE" --state "$TMP_FILE" > "$FILTERED_FILE"; then
    # A successful socket connection can still return an error or a truncated
    # dump. Reconcile the last valid snapshot too, rather than restoring its
    # old ports/DNS merely because the current runtime API is unavailable.
    if [ ! -s "$STATE_FILE" ] || ! python3 "$NORMALIZER" --config "$CONFIG_FILE" --state "$STATE_FILE" > "$FILTERED_FILE"; then
        exit 0
    fi
fi
mv -f "$FILTERED_FILE" "$TMP_FILE"

if [ -f "$STATE_FILE" ] && [ ! -L "$STATE_FILE" ]; then
    chmod --reference="$STATE_FILE" "$TMP_FILE"
    chown --reference="$STATE_FILE" "$TMP_FILE"
else
    chmod 0644 "$TMP_FILE"
fi
mv -f "$TMP_FILE" "$STATE_FILE"
trap - EXIT INT TERM
exit 0
