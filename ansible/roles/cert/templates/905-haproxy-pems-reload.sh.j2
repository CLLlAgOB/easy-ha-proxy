#!/usr/bin/env bash
set -euo pipefail

CERTS_DIR="{{ haproxy_certs_dir | default('/etc/haproxy/certs') }}"
CERTS_AVAILABLE="{{ haproxy_certs_available_dir | default('/etc/haproxy/certs-available') }}"
HAPROXY_SERVICE="haproxy"
HAPROXY_GROUP="haproxy"      # группа, под которой работает haproxy
LIVE_DIR="/etc/letsencrypt/live"

# Certbot-переменные
RENEWED_LINEAGE="${RENEWED_LINEAGE:-}"     # /etc/letsencrypt/live/domain.local-ecdsa
FORCE_ALL="${HAPROXY_PEMS_FORCE_ALL:-1}"   # если =1 — всегда пересобирать все

mkdir -p "$CERTS_DIR"

# A name the operator has put on a standby certificate is held there until
# they hand it back. Checked in this one function because it is the only
# thing in this script that writes into CERTS_DIR, so there is no second path
# that forgot -- the same reason the daemon enforces it inside its own single
# installer.
#
# Without this, switching to a standby would last exactly until the next
# successful renewal, and the operator would learn it had been undone from a
# browser rather than from us.
is_pinned() {
  local stem="$1"
  [[ -s "$CERTS_AVAILABLE/$stem/.pinned" ]]
}

build_pem() {
  local lineage="$1"   # имя lineage (domain.local, domain.local-ecdsa ...)
  local dest="$2"      # /etc/haproxy/certs/domain.local-ecdsa.pem

  local stem
  stem="$(basename "$dest" .pem)"
  if is_pinned "$stem"; then
    echo "Held: $stem is on a standby certificate ($(cat "$CERTS_AVAILABLE/$stem/.pinned")); not replacing it"
    return 0
  fi

  local tmp="${dest}.tmp.$$"
  local fc="$LIVE_DIR/$lineage/fullchain.pem"
  local pk="$LIVE_DIR/$lineage/privkey.pem"

  if [[ ! -f "$fc" || ! -f "$pk" ]]; then
    echo "Skip $lineage (no cert files)"
    return 0
  fi

  umask 077
  cat "$fc" "$pk" > "$tmp"

  # Права: root:haproxy, 0640
  if getent group "$HAPROXY_GROUP" >/dev/null 2>&1; then
    chown root:"$HAPROXY_GROUP" "$tmp"
  else
    # на всякий случай fallback, если группы нет
    chown root:root "$tmp"
  fi
  chmod 0640 "$tmp"

  mv -f "$tmp" "$dest"
  echo "Built: $dest"
}

MANIFEST="$CERTS_DIR/manifest.json"

#
# Режим 1: certbot вызвал deploy-hook с RENEWED_LINEAGE → работаем точечно
#
if [[ -n "$RENEWED_LINEAGE" && "$FORCE_ALL" != "1" ]]; then
  echo "haproxy-pems: single-lineage mode (RENEWED_LINEAGE=$RENEWED_LINEAGE)"

  # Приводим к имени каталога внутри LIVE_DIR
  # /etc/letsencrypt/live/domain.local-ecdsa -> domain.local-ecdsa
  lineage_name="$(basename "$RENEWED_LINEAGE")"

  # 1) Если есть manifest.json — пробуем взять путь из него
  if [[ -f "$MANIFEST" ]]; then
    dest_from_manifest="$(jq -r --arg k "$lineage_name" '.[$k] // empty' "$MANIFEST" 2>/dev/null || echo "")"
    if [[ -n "$dest_from_manifest" ]]; then
      build_pem "$lineage_name" "$dest_from_manifest"
    else
      echo "haproxy-pems: lineage $lineage_name not found in manifest, using auto naming"
      dest_from_manifest=""
    fi
  else
    dest_from_manifest=""
  fi

  # 2) Если manifest не дал dest — используем стандартную схему имён
  if [[ -z "$dest_from_manifest" ]]; then
    if [[ "$lineage_name" =~ ^(.+)-(ecdsa|rsa)$ ]]; then
      base="${BASH_REMATCH[1]}"
      kt="${BASH_REMATCH[2]}"
      dest="$CERTS_DIR/${base}-${kt}.pem"
    else
      base="$lineage_name"
      dest="$CERTS_DIR/${base}.pem"
    fi

    build_pem "$lineage_name" "$dest"
  fi

#
# Режим 2: ручной запуск или FORCE_ALL=1 → пересобираем всё (как раньше)
#
else
  echo "haproxy-pems: full rebuild mode"

  shopt -s nullglob
  declare -A has_type

  # Строим карту: base,ecdsa / base,rsa / base,single
  for d in "$LIVE_DIR"/*; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    if [[ "$name" =~ ^(.+)-(ecdsa|rsa)$ ]]; then
      base="${BASH_REMATCH[1]}"
      kt="${BASH_REMATCH[2]}"
      has_type["$base,$kt"]=1
    else
      has_type["$name,single"]=1
    fi
  done

  if [[ -f "$MANIFEST" ]]; then
    # manifest.json: { "lineage_name": "/etc/haproxy/certs/xxx.pem", ... }
    mapfile -t lineages < <(jq -r 'keys[]' "$MANIFEST")
    for lin in "${lineages[@]}"; do
      dest="$(jq -r --arg k "$lin" '.[$k]' "$MANIFEST")"
      [[ -n "$dest" ]] && build_pem "$lin" "$dest"
    done
  else
    for key in "${!has_type[@]}"; do
      base="${key%,*}"
      kind="${key#*,}"

      if [[ "$kind" == "single" ]]; then
        build_pem "$base" "$CERTS_DIR/${base}.pem"
      else
        ecdsa_present=${has_type["$base,ecdsa"]+yes}
        rsa_present=${has_type["$base,rsa"]+yes}

        if [[ "$ecdsa_present" == "yes" && "$rsa_present" == "yes" ]]; then
          build_pem "${base}-ecdsa" "$CERTS_DIR/${base}-ecdsa.pem"
          build_pem "${base}-rsa"   "$CERTS_DIR/${base}-rsa.pem"
        else
          if [[ "$ecdsa_present" == "yes" ]]; then
            build_pem "${base}-ecdsa" "$CERTS_DIR/${base}-ecdsa.pem"
          elif [[ "$rsa_present" == "yes" ]]; then
            build_pem "${base}-rsa"   "$CERTS_DIR/${base}-rsa.pem"
          fi
        fi
      fi
    done
  fi
fi

# Перезагрузка HAProxy.
#
# The check here used to be
#
#   if systemctl list-unit-files | grep -q "^${HAPROXY_SERVICE}.service"
#
# and this script runs under `set -euo pipefail`. grep -q exits the moment
# it matches, systemctl takes SIGPIPE while it is still writing the other
# four hundred unit names, pipefail makes the pipeline's status 141, and the
# condition is therefore false. Measured on a live gateway: twenty times out
# of twenty. So the reload never ran. Certificates renewed on schedule, the
# PEMs below were rebuilt correctly, and HAProxy went on presenting the
# previous ones until something unrelated happened to reload it -- eight
# hours later, in the incident that turned this up. Left alone it would
# eventually have served an expired certificate.
#
# systemctl cat needs no pipe and fails cleanly when the unit is absent.
if systemctl cat "${HAPROXY_SERVICE}.service" >/dev/null 2>&1; then
  if systemctl reload "$HAPROXY_SERVICE"; then
    echo "Reloaded ${HAPROXY_SERVICE}"
  elif systemctl restart "$HAPROXY_SERVICE"; then
    echo "Restarted ${HAPROXY_SERVICE} (reload was refused)"
  else
    # Loudly. A rebuilt certificate that is not being served is exactly the
    # failure this hook exists to prevent, and the last one was silent:
    # certbot reported "all renewals succeeded" and the notification mail
    # went out as usual.
    echo "ERROR: certificates rebuilt but ${HAPROXY_SERVICE} would not reload" >&2
    exit 1
  fi
else
  echo "No ${HAPROXY_SERVICE}.service on this host; nothing to reload"
fi
