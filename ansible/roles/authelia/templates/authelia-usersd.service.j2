[Unit]
Description=Authelia users management daemon (users_database.yml helper)
After=network.target docker.service
Wants=docker.service

[Service]
Environment="EASY_HA_PROXY_PANEL_SOCKET_USER={{ app_user | default('haproxyadmin') }}"
Type=simple
User=root
Group={{ authelia_log_reader_group }}
ExecStart={{ native_agent_bin | default('/usr/local/sbin/easy-ha-proxy-agent') }} authelia-usersd
Restart=always
RestartSec=2

# The daemon's environment
Environment="AUTHELIA_USERS_FILE={{ authelia_users_file }}"
Environment="AUTHELIA_USERS_SOCKET={{ authelia_users_socket }}"
Environment="AUTHELIA_DOCKER_COMPOSE_FILE={{ authelia_docker_compose_file }}"
Environment="AUTHELIA_CONTAINER_NAME={{ authelia_container_name }}"
Environment="AUTHELIA_CONFIG_PATH={{ authelia_config_path }}"

# Some hardening, but without NoNewPrivileges (root+docker)
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths={{ authelia_root_dir | default('/opt/authelia') }}
ProtectHome=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RuntimeDirectory=easy-ha-proxy
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0007

[Install]
WantedBy=multi-user.target
