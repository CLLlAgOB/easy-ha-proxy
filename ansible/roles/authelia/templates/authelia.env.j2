# Variables shared by Authelia and the mail relay container.
{% set smtp_server = mail_smtp_server %}
{% set smtp_port = mail_smtp_port %}
{% set smtp_username = mail_smtp_username %}
{% set smtp_password = mail_smtp_password %}
{% set relay_tls_mode = mail_smtp_ssl_mode | default('starttls') | string | lower %}
{% set relay_tls_skip_verify = mail_smtp_tls_skip_verify | default(false) | bool %}
{% set relay_sender = mail_notify_from | default('relay@example.invalid', true) %}
{% set relay_domain = (root_domain | default('', true) | string | trim).strip('.') %}
{% if not relay_domain %}
{% set relay_domain = (relay_sender | string).split('@')[-1].strip('.') %}
{% endif %}
{% set relay_hostname = 'mail-relay.' ~ relay_domain %}

# External SMTP settings.
MAIL_SMTP_SERVER={{ (smtp_server | string | replace('$', '$$')) | to_json(ensure_ascii=False) }}
MAIL_SMTP_PORT={{ (smtp_port | string) | to_json }}
MAIL_SMTP_USERNAME={{ (smtp_username | string | replace('$', '$$')) | to_json(ensure_ascii=False) }}
MAIL_SMTP_PASSWORD={{ (smtp_password | string | replace('$', '$$')) | to_json(ensure_ascii=False) }}
EASY_HA_PROXY_SMTP_TLS_MODE={{ (relay_tls_mode | string) | to_json }}

# Variables consumed by the mail_relay image.
SERVER_HOSTNAME={{ (relay_hostname | replace('$', '$$')) | to_json(ensure_ascii=False) }}
SMTP_SERVER={{ (smtp_server | string | replace('$', '$$')) | to_json(ensure_ascii=False) }}
SMTP_PORT={{ (smtp_port | string) | to_json }}
SMTP_USERNAME={{ (smtp_username | string | replace('$', '$$')) | to_json(ensure_ascii=False) }}
SMTP_PASSWORD={{ (smtp_password | string | replace('$', '$$')) | to_json(ensure_ascii=False) }}
POSTFIX_smtp_tls_security_level={{ ('none' if relay_tls_mode == 'plain' else ('encrypt' if relay_tls_skip_verify else 'verify')) | to_json }}
POSTFIX_smtp_tls_wrappermode={{ ('yes' if relay_tls_mode == 'smtps' else 'no') | to_json }}
POSTFIX_smtp_use_tls={{ ('no' if relay_tls_mode == 'plain' else 'yes') | to_json }}
POSTFIX_smtp_tls_CAfile={{ '/etc/ssl/certs/ca-certificates.crt' | to_json }}
POSTFIX_smtp_connect_timeout={{ (mail_smtp_timeout | default('10s') | string) | to_json }}
